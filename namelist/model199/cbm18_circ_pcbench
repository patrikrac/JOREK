! =====================================================================
!  cbm18_circ_pcbench
!  Peeling-ballooning benchmark case for the physics PC (docs/physics_pc).
!
!  Second physics case for Stage 4.2b.  Everything measured so far comes
!  from `intear_pcbench_gradients`: a 2/1 tearing mode, weak flow, n = 1,
!  very large aspect ratio, low beta.  This case is the opposite corner:
!  a high-beta ballooning-unstable pedestal at n = 6 and tstep = 3, which
!  sits inside the measured M1a / M2e crossover window.
!
!  Derived from `namelist/model302/cbm18_in` (the CBM18 case of the JOREK
!  "running JOREK for the first time" howto), which is ALREADY the
!  circular-limiter geometry: `n_boundary = 0` makes its 513-point
!  R_boundary/Z_boundary table inert, and ellip=1, tria=quad=0, amin=2,
!  R_geo=3 is a circular cross-section at inverse aspect ratio 2/3.
!
!  Changes relative to cbm18_in:
!    - tstep 2 -> 3            (the regime under study)
!    - ZK_par  0 -> 10.        \  otherwise L_T_psi ~ (ZK_par-ZK_perp) grad T0
!    - D_par   0 -> 1.         /  and L_rho_psi are structurally ZERO and the
!                                 rho/T-channel question cannot be asked at all.
!                                 ZK_par = 10 is taken from model303/inxflow.
!    - D_perp, ZK_perp 1e-7 -> 1e-6   (matches the tearing benchmark scaling)
!    - mesh: diagnostic resolution, see below
!    - the physics-PC / solver tail copied from intear_pcbench_gradients
!
!  NOT taken from inxflow: its X-point geometry.  A diverted mesh changes
!  the boundary treatment, and `eliminate_boundary_dofs` -- which every
!  measurement in this study depends on -- is untested on open field lines.
!
!  --- Compile-time settings -------------------------------------------
!  n_tor / n_period / n_plane are in models/mod_settings.f90, NOT here.
!  Two separate builds are needed (util/config.sh):
!    axisymmetric cold start :  ./util/config.sh model=199 n_tor=1 n_plane=1
!    ballooning run          :  ./util/config.sh model=199 n_tor=3 n_period=6 n_plane=4
!  With n_tor=3, n_period=6, det_modes.f90 gives harmonics n = 0 and n = 6.
!
!  --- Workflow ---------------------------------------------------------
!  1. n_tor=1 build, restart=.f., use_physics_pc=.f.: relax the projected
!     Grad-Shafranov equilibrium until E_kin(n=0) reaches a plateau.  This
!     step is REQUIRED here: the Stage 4.2 equilibrium measurement assumes
!     u0 ~ 0 (that is what makes dpsi_vs_mass and dpsi_vs_B11 coincide and
!     is how the ADV1 block is isolated), and CBM18's steep pedestal leaves
!     much larger startup transients than the mild `intear` profiles.
!  2. n_tor=3/n_period=6 build, restart=.t.: JOREK seeds the new harmonics
!     at 1e-10 * the axisymmetric rho and T (mod_import_restart.f90).
!  3. Diagnostics: restart=.t., nstep=1, use_physics_pc=.t.
!
!  Mesh: the values below are the DIAGNOSTIC resolution (the Schur probing
!  in verify_schur_approx_4x4 costs O(N) direct solves, so it must stay
!  small).  Ladder used for the h-study: 13x24, 17x28, 21x32.
!  For the physics check (growth rate of n=6) use cbm18's own resolution:
!    n_radial=81  n_pol=128  n_flux=51  n_tht=128
!
!  Run on 1 MPI rank: the physics PC apply path fails for np > 1
!  (pre-existing, independent of this work).
! =====================================================================

&in1

 restart = .f.
 regrid  = .f.
 refinement = .false.

 tstep   = 3.
 nstep   = 1
 nout    = 1

 fbnd(1)   = 2.
 fbnd(2:4) = 0.
 mf        = 0

 freeboundary = .f.
 n_boundary   = 0

 ellip  = 1.
 tria_u = 0.
 tria_l = 0.
 quad_u = 0.
 quad_l = 0.

 xpoint = .f.

 R_geo = 3.0
 Z_geo = 0.
 amin  = 2.

 F0    = 6.

 n_R      = 0
 n_Z      = 0
 n_radial = 13
 n_pol    = 24

 n_flux    = 11
 n_tht     = 24
 n_open    = 0
 n_leg     = 0
 n_private = 0

! radial packing on the pedestal (from cbm18_in)
 xr1  = 0.76
 sig1 = 0.06

 eta       = 1.d-7
 visco     = 1.d-7
 visco_par = 1.d-7

 tauIC = 0.00

 eta_num   = 1.d-10
 visco_num = 1.d-10

! D_par / ZK_par raised from cbm18's 0: they are the ONLY thing that makes
! L_rho_psi and the parallel part of L_T_psi nonzero.
 D_par     = 1.d0
 D_perp    = 1.d-6

 ZK_par    = 10.d0
 ZK_perp   = 1.d-6

 FF_0 = 3.28
 FF_1 = 0.
 FF_coef(1)  = -0.328
 FF_coef(2)  = -2.924
 FF_coef(3)  =  2.297
 FF_coef(4)  =  0.1895
 FF_coef(5)  =  0.5149
 FF_coef(6)  = -1.226d0
 FF_coef(7)  =  0.5974d0
 FF_coef(8)  =  0.0424d0

! Held in reserve: if the pedestal washes out during the relaxation phase
! before the n=6 mode grows, turn these on (values from model303/inxflow)
! rather than re-tuning the equilibrium.
 heatsource     = 0.d0
 particlesource = 0.d0

! T_coef(1:3) = cubic in psi_n, (4) = barrier width, (5) = barrier position
! (models/temperature.f90:47-53).  This is the ballooning drive.
 T_0 = 0.038727
 T_1 = 0.
 T_coef(1) = -0.2191
 T_coef(2) = -0.1901
 T_coef(3) =  0.0503
 T_coef(4) =  0.0398
 T_coef(5) =  0.5893

 rho_0 = 1.
 rho_1 = 1.
 rho_coef(1)  =  0.
 rho_coef(2)  =  0.
 rho_coef(3)  =  0.
 rho_coef(4)  = 99.
 rho_coef(5)  = 99.

 iter_precon    = 22
 gmres_m        = 20
 gmres_4        = 1.d0
 gmres_max_iter = 200
 gmres_tol      = 1.d-8

! --- physics PC -------------------------------------------------------
! Eliminate the Dirichlet DOFs (row+column zeroed, representative diagonal)
! instead of the 1e12 ZBIG penalty.  Required for this study: the penalty
! rows otherwise dominate every operator norm.
 eliminate_boundary_dofs      = .t.

 use_physics_pc               = .t.
 debug_physics_pc             = .f.
 physics_pc_monolithic        = .t.
 physics_pc_reduced_pde       = .t.
 physics_pc_drop_psi_coupling = .f.
 physics_pc_verify_reduced    = .f.

! this build has no MUMPS/STRUMPACK bindings; MUMPS is reached via PETSc
 use_strumpack     = .f.
 use_strumpack_eq  = .f.
 use_strumpack_prj = .f.
 use_mumps         = .f.
 use_mumps_eq      = .f.
 use_mumps_prj     = .f.
 use_pastix        = .f.
 use_pastix_eq     = .f.
 use_pastix_prj    = .f.
 use_petsc_eq      = .t.
/
