! =====================================================================
!  inxflow600_circ_pcbench  (model600)
!  The model199 physics-PC benchmark namelist/model199/inxflow600_circ_pcbench
!  run on model600 itself, to test the SF preconditioner on the production
!  model family.  Geometry, mesh, drive (eta = 2.d-5) and sources are
!  unchanged; see the model199 file for how the case and its drive were
!  found.
!
!  --- Compile-time settings --------------------------------------------
!  model600 with every extension off: n_var = 6, the slots of model199
!  (psi u zj w rho T).  use_physics_pc refuses anything else.
!    ./util/config.sh model=600 n_tor=1 n_period=1 n_plane=1 \
!        with_vpar=.false. with_TiTe=.false. with_neutrals=.false. with_impurities=.false.
!    ./util/config.sh model=600 n_tor=3 n_period=6 n_plane=4      (same extensions)
!  (on macOS check models/model600/mod_model_settings.f90 afterwards:
!  config.sh can leave ".false.true." there.)
!
!  --- Physics: "matched" (default below) vs "native" -------------------
!  matched: model600 brought as close to model199 as its switches allow,
!  so that differences in the PC come from the model, not the physics:
!    tauIC = 0          no diamagnetic terms (B_15, B_56, parts of B_11/B_22)
!    bootstrap = .f.    model199 has no bootstrap current
!    NEO = .f.          no neoclassical friction in the u row
!    tgnum_* = 0        no Taylor-Galerkin terms (model199 has none)
!    eta_coul_log_dep = .f.   eta ~ T^-1.5, model199's eta_T_dependent law
!    visco_old_setup  = .t.   the R visco grad v.grad w viscosity of model199
!  native: the values of reg_tests/testcases/inxflow_600_vpar_T_all, v_par
!  still off:
!    tauIC = 1.d-3, bootstrap = .t., bootstrap_psin_cutoff = 10.d0,
!    NEO = .t., aki_neo_const = -1.e+0, amu_neo_const = +1.e-5,
!    tgnum_psi/u/zj/w/rho/T = 0.2d0
!
!  --- Workflow (as for model199) ---------------------------------------
!  stage 1, axisymmetric, ramped:
!    ./util/setinput.sh inxflow600_circ_pcbench \
!        tstep_n=1.d-3,1.d-2,1.d-1,1.d0,3.d0 nstep_n=10,10,10,10,10 restart=.f. nout=5
!    mpirun -n 1 ./jorek_model600_ntor1 < inxflow600_circ_pcbench
!  stage 2, n = 0 and 6 to a growing mode:
!    ./util/setinput.sh inxflow600_circ_pcbench tstep_n=3.d0 nstep_n=1000 restart=.t. nout=25
!    mpirun -n 1 ./jorek_model600 < inxflow600_circ_pcbench
!  stage 3, the arms, from one restart: change ONLY the physics-PC block,
!  with eliminate_boundary_dofs = .t. in every arm.
! =====================================================================

&in1

 restart = .f.
 regrid  = .f.

 tstep_n   = 1.d-3,1.d-2,1.d-1,1.d0,3.d0
 nstep_n   = 10,10,10,10,10

 nout = 5

 n_tor_fft_thresh = 2

 freeboundary = .f.

 fbnd(1)   = 2.
 fbnd(2:4) = 0.
 mf        = 0

! --- circular limiter geometry ---------------------------------------
 ellip  = 1.
 tria_u = 0.
 tria_l = 0.
 quad_u = 0.
 quad_l = 0.

 xpoint = .f.
 xampl  = 0.
 xsig   = 0.6
 xwidth = 1.5
 xtheta = 4.7
 xshift = 0.0

 R_begin = 2.9
 R_end   = 3.1
 Z_begin = -0.1
 Z_end   = 0.1

 R_geo = 3.0
 Z_geo = 0.
 amin  = 1.

 F0    = 3.0

! --- mesh --------------------------------------------------------------
! n_flux 25, not model199's 24: the SF path's GMG needs (n_flux-1) even and
! n_tht divisible by 4 to coarsen the flux-surface grid.
 n_R      = 0
 n_Z      = 0
 n_radial = 41
 n_pol    = 64

 n_flux    = 25
 n_tht     = 32
 n_open    = 0
 n_leg     = 0
 n_private = 0

! --- transport (eta = 2.d-5 is the drive, see the model199 file) -------
 eta       = 2.d-5
 eta_ohmic = 1.d-7
 visco     = 4.d-6

 eta_num   = 3.d-10
 visco_num = 1.d-11

 eta_coul_log_dep = .f.
 visco_old_setup  = .t.

 D_par     = 0.d0
 D_perp(1) = 1.d-5
 D_perp(2) = 0.85d0
 D_perp(3) = 0.d0
 D_perp(4) = 0.01d0
 D_perp(5) = 0.92d0

 ZK_par     = 100.d0
 ZK_perp(1) = 1.d-5
 ZK_perp(2) = 0.85d0
 ZK_perp(3) = 0.d0
 ZK_perp(4) = 0.01d0
 ZK_perp(5) = 0.92d0

! --- model600-only physics: "matched" (see header) ---------------------
 tauIC     = 0.d0
 bootstrap = .f.
 NEO       = .f.
 tgnum_psi = 0.d0
 tgnum_u   = 0.d0
 tgnum_zj  = 0.d0
 tgnum_w   = 0.d0
 tgnum_rho = 0.d0
 tgnum_T   = 0.d0

! --- equilibrium ------------------------------------------------------
 FF_0 = 1.6
 FF_1 = 0.
 FF_coef(1)  = -1.0
 FF_coef(2)  = 0.d0
 FF_coef(3)  = 0.d0
 FF_coef(4)  = 0.03d0
 FF_coef(5)  = 1.0d0
 FF_coef(6)  = -0.06d0
 FF_coef(7)  = 0.90d0
 FF_coef(8)  = 0.07d0

 T_0 = 1.5d-2
 T_1 = 3.d-4
 T_coef(1) = -0.66d0
 T_coef(2) = +0.0d0
 T_coef(3) = 0.d0
 T_coef(4) = 0.08d0
 T_coef(5) = 0.94d0

 rho_0 = 1.
 rho_1 = 0.01
 rho_coef(1)  =  0.0
 rho_coef(2)  =  0.0
 rho_coef(3)  =  0.0
 rho_coef(4)  =  0.08
 rho_coef(5)  =  0.94d0

! --- sources ----------------------------------------------------------
 heatsource                = 1.d-7
 particlesource            = 5.d-6
 edgeparticlesource        = 1.d-7
 edgeparticlesource_psin   = 1.d0
 edgeparticlesource_sig    = 0.03d0
 particlesource_gauss      = 1.d-7
 particlesource_gauss_psin = 0.d0
 particlesource_gauss_sig  = 0.1d0
 heatsource_gauss          = 1.d-8
 heatsource_gauss_psin     = 0.d0
 heatsource_gauss_sig      = 0.1d0

! --- solver -----------------------------------------------------------
 iter_precon    = 22
 gmres_m        = 20
 gmres_4        = 1.d0
 gmres_max_iter = 200
 gmres_tol      = 1.d-8

! --- physics PC -------------------------------------------------------
! Eliminate the Dirichlet DOFs (row+column zeroed, representative diagonal)
! instead of the 1e12 ZBIG penalty.  Wanted for the PC study: the penalty
! rows otherwise dominate every operator norm.
!
! CAUTION: this flag is ours, it is in no stock JOREK case, and it is applied
! to the MAIN system matrix (matrix/construct_matrix_mod.f90:474-748), not
! only to the PC matrices -- so it changes the boundary condition of the
! physics solve.  Keep it OFF for the stage-1/stage-2 physics runs; for the
! stage-3 two-arm comparison it must be ON and IDENTICAL in both arms, or
! the two arms are not solving the same problem.
 eliminate_boundary_dofs      = .f.

! use_physics_pc = .t.: the split-field (SF) preconditioner in its production
! configuration (the physics_pc_sf_* defaults, models/phys_module.f90). Its
! mode split needs >= (n_tor+1)/2 MPI ranks; for fewer set
! physics_pc_sf_mode_split = .f.
 use_physics_pc               = .f.

! this build has no MUMPS/STRUMPACK bindings; MUMPS is reached via PETSc
 use_strumpack     = .f.
 use_strumpack_eq  = .f.
 use_strumpack_prj = .f.
 use_mumps         = .f.
 use_mumps_eq      = .f.
 use_mumps_prj     = .f.
 use_pastix        = .f.
 use_pastix_eq     = .f.
 use_pastix_prj    = .f.
 use_petsc_eq      = .t.
/
