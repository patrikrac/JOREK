#pragma once

/*
 * ============================================================================
 * JOREK Version and Build Information Header
 *
 * DO NOT EDIT THIS FILE DIRECTLY.
 * It is automatically generated by CMake from version.h.in during the build
 * configuration process.
 * ============================================================================
 */


// --- Git Version Information ---
// The unique identifier for the git commit
#define RCS_VERSION         "@GIT_RCS_VERSION@"

// The most recent git tag
#define JOREK_VERSION       "@GIT_JOREK_VERSION@"

// The commit message summary
#define RCS_LABEL           "@GIT_RCS_LABEL@"

// The commit date and time
#define RCS_TIME            "@GIT_RCS_TIME@"


// --- Build Environment Information ---
// The user who ran the build
#define COMPILE_USER        "@JOREK_COMPILE_USER@"

// The machine where the build was run
#define COMPILE_MACHINE     "@JOREK_COMPILE_MACHINE@"

// The directory where the build was configured
#define COMPILE_DIR         "@CMAKE_BINARY_DIR@"

// Environment modules loaded during configuration (if any)
#define COMPILE_MODULES     "@JOREK_LOADED_MODULES@"


// --- Compilation Details ---
// The Fortran compiler command used
#define COMPILE_COMMAND     "@CMAKE_Fortran_COMPILER@"

// The full set of Fortran compiler flags
#define COMPILE_FLAGS       "@JOREK_COMPILE_FLAGS@"

// The include paths used by the compiler
#define COMPILE_INCLUDES    "@JOREK_COMPILE_INCLUDES@"

// The preprocessor definitions used
#define COMPILE_DEFINES     "@JOREK_COMPILE_DEFINITIONS@"

// The libraries linked against the final executable
#define COMPILE_LIBS        "@JOREK_COMPILE_LIBS@"